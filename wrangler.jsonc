{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "timesheeter",
  "compatibility_date": "2026-07-02",
  "main": "worker/index.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Run the Worker before the static-assets/SPA layer for API routes.
    // Without this, navigation requests (Sec-Fetch-Mode: navigate) to
    // /api/wrike/oauth/* get served index.html instead of hitting the Worker,
    // which breaks the OAuth redirect + callback. /r is the page a Wrike
    // comment links to for a Reviewer link, so it must reach the Worker too.
    "run_worker_first": ["/api/*", "/r"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "WRIKE_CLIENT_ID": "EzRrr1FJ",
    // Public, like Wrike's: it names the app to Google. The secret is a
    // Worker secret (GOOGLE_CLIENT_SECRET).
    "GOOGLE_CLIENT_ID": "1047837005704-h04jm219u2mm5rojhpv1vo797rei5v3a.apps.googleusercontent.com",
    "SUPABASE_URL": "https://oozopadfrupwujsagagn.supabase.co",
    // Whose Wrike and Google connections the Enterprise Uploads sweep uses: a
    // TimeHub person's full or first name. Tasks show as made by them.
    "UPLOADS_RUN_AS": "James"
  },
  // Every half hour: Enterprise Uploads from the AMs' sheet into Wrike
  // (worker/uploadsSweep.js).
  "triggers": {
    "crons": ["*/30 * * * *"]
  }
}
